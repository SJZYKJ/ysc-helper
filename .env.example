# 复制为 .env 后 docker compose 会自动读取（同目录），用于替换 compose 里的 ${VAR}
# 公网部署请务必设置 BASIC_AUTH，否则本服务等于一个开放的 HTTP 抓取代理。

# 全站 Basic 认证：用户名:密码（留空 = 不认证）
BASIC_AUTH=

# 基础镜像（国内拉不到 Docker Hub 时换成加速地址）
# BASE_IMAGE=docker.1ms.run/library/node:22-alpine

# 抓取并发（默认 8，源站敏感时下调）
# SCAN_CONCURRENCY=8

# 单次抓取超时毫秒（默认 8000）
# REQUEST_TIMEOUT_MS=8000

# 历史保留条数（默认 20）
# MAX_HISTORY=20

# 允许抓取内网/回环地址（默认 0；仅本地调试时置 1）
# ALLOW_PRIVATE_TARGETS=0
